<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:scrollbars="none"
    tools:context=".ui.dashboard.MeditateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meditation"
            android:textColor="@color/primary_maroon"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_user_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_taupe_light"
            android:textSize="16sp"
            tools:text="Jai Guru, User" />

        <!-- Duration Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="DURATION"
            android:textColor="@color/text_taupe_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Exact Original Duration Chips Layout with checkable attributes added -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duration_5min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="18sp"
                    android:text="05 min"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duration_10min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="18sp"
                    android:text="10 min"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duration_15min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="18sp"
                    android:text="15 min"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duration_20min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="18sp"
                    android:text="20 min"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duration_25min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="18sp"
                    android:text="25 min"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/duration_30min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:textSize="18sp"
                    android:text="30 min"/>
            </com.google.android.material.card.MaterialCardView>


            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="duration_5min,duration_10min,duration_15min,duration_20min,duration_25min,duration_30min"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="spread"
                app:flow_horizontalBias="0.0"
                app:flow_horizontalGap="8dp"
                app:flow_verticalGap="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Custom Duration Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#0D000000"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <EditText
                    android:id="@+id/edit_custom_duration"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:hint="Custom (e.g. 45)"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_taupe"
                    android:textColorHint="@color/text_taupe_light"
                    tools:text="" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="minutes"
                android:textColor="@color/text_taupe_light"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Om Chanting Toggle Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_taupe"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Om Dhwani Chanting"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Play Om chant softly during meditation"
                        android:textColor="@color/text_taupe_light"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_om_chanting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Timer Ring -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_timer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:max="1000000"
                android:progress="1000000"
                app:showAnimationBehavior="none"
                app:indicatorColor="@color/primary_maroon"
                app:indicatorSize="220dp"
                app:trackColor="@color/secondary_rose"
                app:trackThickness="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_timer_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00"
                    android:textStyle="bold"
                    android:textColor="@color/primary_maroon"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="remaining"
                    android:textColor="#BDB4AF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:background="#E8E0D5" />

        <!-- Ready Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ready"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/primary_maroon"
            android:text="I am Ready"
            android:textAllCaps="false"
            style="@style/Widget.GuruVandan.Button"
            app:cornerRadius="12dp" />

        <!-- 1. ACTIVE MEDITATION CONTROLLER (Reload & Play/Pause) -->
        <LinearLayout
            android:id="@+id/layout_active_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Reload / Reset Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_reload"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="32dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:rippleColor="#4DFFFFFF"
                app:strokeColor="#E8E0D5"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reload Timer"
                    android:src="@drawable/reload"
                    app:tint="@color/primary_maroon" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Play / Pause Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_play_pause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/primary_maroon"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:rippleColor="#4DFFFFFF"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/button_play_pause_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play Audio"
                    android:src="@drawable/play"
                    app:tint="@color/text_white" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- 2. COMPLETED STATE (Message & Finish Button) -->
        <LinearLayout
            android:id="@+id/layout_completed_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_completion_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Meditation complete. May your peace remain."
                android:textAlignment="center"
                android:textColor="@color/accent_gold"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Final Meditation Icon Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_finish_meditation"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:rippleColor="#4DFFFFFF"
                app:strokeColor="#E8E0D5"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="Finish Meditation"
                    android:src="@drawable/nav_meditation_icon"
                    app:tint="@color/primary_maroon" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Guidance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_taupe"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guidance for Meditation"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/guidance_for_meditation_desc"
                    android:textColor="@color/text_taupe_light"
                    android:justificationMode="inter_character"
                    android:textSize="17sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>