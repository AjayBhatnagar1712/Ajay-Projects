<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="40dp"
    app:cardBackgroundColor="@color/bg_cream"
    android:gravity="center"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_maroon"
            android:backgroundTint="@color/primary_maroon"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                android:foreground="@drawable/rounded_circle_border"
                app:cardCornerRadius="400dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="Guru Ji Image"
                    android:src="@drawable/guru_image_square"
                    android:cropToPadding="true"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/bg_cream"
                android:layout_marginTop="20dp"
                android:textSize="24sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:id="@+id/welcome_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jai_guru"
                android:textColor="@color/primary_maroon"
                android:layout_marginTop="20dp"
                android:textSize="24sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/double_inverted_comma"
                android:textColor="@color/primary_maroon"
                android:alpha="0.3"
                android:textSize="48sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_message"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Button
                android:id="@+id/button_enter"
                style="@style/Widget.GuruVandan.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="प्रवेश करें — Enter"
                android:textAllCaps="false"
                android:layout_marginTop="30dp"
                android:textSize="20sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>